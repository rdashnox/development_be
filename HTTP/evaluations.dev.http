###############################################################
# FR-08 EVALUATION MANAGEMENT
# Manual REST Client Tests
#
# Current implementation:
# - HTE Supervisor evaluations
# - Faculty Adviser evaluations
# - Draft -> Submitted lifecycle
# - Final eligibility required for create/submit
# - Evaluator ownership enforced
# - Student read-only access to submitted evaluations
# - Administrator / Coordinator read-only access
###############################################################


###############################################################
# VARIABLES
###############################################################

@apiUrl=http://localhost:8000/api/v1


###############################################################
# SEEDED EVALUATION-READY INTERNSHIP
###############################################################

### Use the seeded completed internship for Student 1.
###
### Seeded configuration:
### Student: studentsbims1@grr.la
### HTE: HTE 1
### Faculty Adviser: Faculty Adviser 1
### Start: 2026-08-17
### End: 2026-09-12
### Required Hours: 150
### Status: completed
### Validated Rendered Hours: 150

@internshipId=REPLACE_WITH_STUDENT1_INTERNSHIP_UUID


###############################################################
# EVALUATION IDs
###############################################################

### Replace after creating the HTE evaluation.

@hteEvaluationId=REPLACE_WITH_HTE_EVALUATION_UUID

### Replace after creating the Faculty Adviser evaluation.

@facultyEvaluationId=REPLACE_WITH_FACULTY_EVALUATION_UUID


###############################################################
# SEED USERS
###############################################################

@admin=adminsbims1@grr.la
@coordinator=coordinatorsbims1@grr.la

### Evaluation-ready student

@student=studentsbims1@grr.la

### Faculty Adviser assigned to Student 1

@faculty=facultysbims1@grr.la

### HTE Supervisor assigned to Student 1
###
### Replace with the actual seeded HTE Supervisor 1 account.
### If your users seed uses a different email, use that account.

@hteSupervisor=htesbims1@grr.la
@hteSupervisorAccessToken=REPLACE_WITH_HTE_SUPERVISOR_ACCESS_TOKEN


###############################################################
# OTHER USERS
###############################################################

### Another HTE Supervisor who is NOT assigned to Student 1.

@otherHteSupervisor=htesbims2@grr.la

### Faculty Adviser who is NOT assigned to Student 1.

@otherFaculty=facultysbims3@grr.la


###############################################################
# SHARED TEST PASSWORD
###############################################################

@password=TestPassword2026!


###############################################################
# AUTHENTICATION
###############################################################


### Login as Administrator

# @name adminLogin

POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{admin}}",
  "password": "{{password}}"
}


### Login as Internship Coordinator

# @name coordinatorLogin

POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{coordinator}}",
  "password": "{{password}}"
}


### Login as Student

# @name studentLogin

POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{student}}",
  "password": "{{password}}"
}


### Login as HTE Supervisor

# @name hteSupervisorLogin

POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{hteSupervisor}}",
  "password": "{{password}}"
}


### Login as Other HTE Supervisor

# @name otherHteSupervisorLogin

POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{otherHteSupervisor}}",
  "password": "{{password}}"
}


### Login as Faculty Adviser

# @name facultyLogin

POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{faculty}}",
  "password": "{{password}}"
}


### Login as Other Faculty Adviser

# @name otherFacultyLogin

POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{otherFaculty}}",
  "password": "{{password}}"
}


###############################################################
# HTE SUPERVISOR - CREATE
###############################################################


### 1. HTE Supervisor Creates Evaluation
###
### Expected: 201 Created
###
### Conditions:
### - Authenticated HTE Supervisor
### - Assigned to the internship's HTE
### - evaluation_type = hte_supervisor
### - Internship period has ended
### - Required hours are set
### - Validated rendered hours >= required hours
###
### NOTE:
### The seeded Student 1 internship should satisfy these conditions.

# @name createHteEvaluation

POST {{apiUrl}}/evaluations
Authorization: Bearer {{hteSupervisorLogin.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "internship_id": "{{internshipId}}",
  "evaluation_type": "hte_supervisor",
  "responses": {
    "criterion_1": 5,
    "criterion_2": 4,
    "criterion_3": 5
  },
  "comments": "Good performance during the internship."
}


###############################################################
# HTE SUPERVISOR - RETRIEVE
###############################################################


### 2. HTE Supervisor Gets Own Evaluations
###
### Expected: 200 OK

GET {{apiUrl}}/evaluations/me
Authorization: Bearer {{hteSupervisorLogin.response.body.$.data.accessToken}}


### 3. HTE Supervisor Gets Internship Evaluations
###
### Expected: 200 OK
###
### The HTE Supervisor must be assigned to the internship.

GET {{apiUrl}}/evaluations/internship/{{internshipId}}
Authorization: Bearer {{hteSupervisorLogin.response.body.$.data.accessToken}}


### 4. HTE Supervisor Gets Specific Evaluation
###
### Expected: 200 OK

GET {{apiUrl}}/evaluations/{{hteEvaluationId}}
Authorization: Bearer {{hteSupervisorLogin.response.body.$.data.accessToken}}


###############################################################
# HTE SUPERVISOR - UPDATE
###############################################################


### 5. Update HTE Draft Evaluation
###
### Expected: 200 OK
###
### The evaluator who owns the evaluation may update
### a draft evaluation.

PATCH {{apiUrl}}/evaluations/{{hteEvaluationId}}
Authorization: Bearer {{hteSupervisorLogin.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "responses": {
    "criterion_1": 5,
    "criterion_2": 5,
    "criterion_3": 4
  },
  "comments": "Updated evaluation comments."
}


###############################################################
# HTE SUPERVISOR - SUBMIT
###############################################################


### 6. Submit HTE Evaluation
###
### Expected: 200 OK
### Status: draft -> submitted
###
### Final eligibility is checked again before submission.

POST {{apiUrl}}/evaluations/{{hteEvaluationId}}/submit
Authorization: Bearer {{hteSupervisorLogin.response.body.$.data.accessToken}}


### 7. Submit HTE Evaluation Again
###
### Expected: 400 Bad Request
###
### Submitted evaluations cannot be submitted again.

POST {{apiUrl}}/evaluations/{{hteEvaluationId}}/submit
Authorization: Bearer {{hteSupervisorLogin.response.body.$.data.accessToken}}


### 8. Modify Submitted HTE Evaluation
###
### Expected: 400 Bad Request
###
### Submitted evaluations cannot be modified.

PATCH {{apiUrl}}/evaluations/{{hteEvaluationId}}
Authorization: Bearer {{hteSupervisorLogin.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "comments": "Attempted modification after submission."
}


###############################################################
# FACULTY ADVISER - CREATE
###############################################################


### 9. Faculty Adviser Creates Evaluation
###
### Expected: 201 Created
###
### Conditions:
### - Authenticated Faculty Adviser
### - Faculty Adviser is assigned to the internship
### - evaluation_type = faculty_adviser
### - Internship is finally eligible

# @name createFacultyEvaluation

POST {{apiUrl}}/evaluations
Authorization: Bearer {{facultyLogin.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "internship_id": "{{internshipId}}",
  "evaluation_type": "faculty_adviser",
  "responses": {
    "criterion_1": 5,
    "criterion_2": 5,
    "criterion_3": 4
  },
  "comments": "Student demonstrated satisfactory internship performance."
}


###############################################################
# FACULTY ADVISER - RETRIEVE
###############################################################


### 10. Faculty Adviser Gets Own Evaluations
###
### Expected: 200 OK

GET {{apiUrl}}/evaluations/me
Authorization: Bearer {{facultyLogin.response.body.$.data.accessToken}}


### 11. Faculty Adviser Gets Internship Evaluations
###
### Expected: 200 OK

GET {{apiUrl}}/evaluations/internship/{{internshipId}}
Authorization: Bearer {{facultyLogin.response.body.$.data.accessToken}}


### 12. Faculty Adviser Gets Specific Evaluation
###
### Expected: 200 OK

GET {{apiUrl}}/evaluations/{{facultyEvaluationId}}
Authorization: Bearer {{facultyLogin.response.body.$.data.accessToken}}


###############################################################
# FACULTY ADVISER - UPDATE / SUBMIT
###############################################################


### 13. Update Faculty Adviser Draft
###
### Expected: 200 OK

PATCH {{apiUrl}}/evaluations/{{facultyEvaluationId}}
Authorization: Bearer {{facultyLogin.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "responses": {
    "criterion_1": 5,
    "criterion_2": 5,
    "criterion_3": 5
  },
  "comments": "Updated faculty adviser evaluation."
}


### 14. Submit Faculty Adviser Evaluation
###
### Expected: 200 OK
### Status: draft -> submitted

POST {{apiUrl}}/evaluations/{{facultyEvaluationId}}/submit
Authorization: Bearer {{facultyLogin.response.body.$.data.accessToken}}


### 15. Modify Submitted Faculty Evaluation
###
### Expected: 400 Bad Request

PATCH {{apiUrl}}/evaluations/{{facultyEvaluationId}}
Authorization: Bearer {{facultyLogin.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "comments": "Attempted modification after submission."
}


###############################################################
# STUDENT - READ ONLY
###############################################################


### 16. Student Retrieves Submitted HTE Evaluation
###
### Expected: 200 OK
###
### Student may view submitted evaluations for own internship.

GET {{apiUrl}}/evaluations/{{hteEvaluationId}}
Authorization: Bearer {{studentLogin.response.body.$.data.accessToken}}


### 17. Student Retrieves Internship Evaluations
###
### Expected: 200 OK
###
### Only submitted evaluations should be exposed to the student.

GET {{apiUrl}}/evaluations/internship/{{internshipId}}
Authorization: Bearer {{studentLogin.response.body.$.data.accessToken}}


### 18. Student Attempts to Create Evaluation
###
### Expected: 403 Forbidden

POST {{apiUrl}}/evaluations
Authorization: Bearer {{studentLogin.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "internship_id": "{{internshipId}}",
  "evaluation_type": "hte_supervisor",
  "responses": {
    "criterion_1": 5
  }
}


### 19. Student Attempts to Modify Evaluation
###
### Expected: 403 Forbidden

PATCH {{apiUrl}}/evaluations/{{hteEvaluationId}}
Authorization: Bearer {{studentLogin.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "comments": "Student attempting to modify evaluation."
}


### 20. Student Attempts to Submit Evaluation
###
### Expected: 403 Forbidden

POST {{apiUrl}}/evaluations/{{hteEvaluationId}}/submit
Authorization: Bearer {{studentLogin.response.body.$.data.accessToken}}


###############################################################
# HTE SUPERVISOR AUTHORIZATION
###############################################################


### 21. Unassigned HTE Supervisor Views Evaluation
###
### Expected: 403 Forbidden
###
### Role alone is insufficient.
### The HTE Supervisor must be assigned to the internship.

GET {{apiUrl}}/evaluations/{{hteEvaluationId}}
Authorization: Bearer {{otherHteSupervisorLogin.response.body.$.data.accessToken}}


### 22. Unassigned HTE Supervisor Views Internship Evaluations
###
### Expected: 403 Forbidden

GET {{apiUrl}}/evaluations/internship/{{internshipId}}
Authorization: Bearer {{otherHteSupervisorLogin.response.body.$.data.accessToken}}


### 23. Unassigned HTE Supervisor Creates Evaluation
###
### Expected: 403 Forbidden

POST {{apiUrl}}/evaluations
Authorization: Bearer {{otherHteSupervisorLogin.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "internship_id": "{{internshipId}}",
  "evaluation_type": "hte_supervisor",
  "responses": {
    "criterion_1": 5,
    "criterion_2": 4
  }
}


###############################################################
# FACULTY ADVISER AUTHORIZATION
###############################################################


### 24. Unassigned Faculty Adviser Views Evaluation
###
### Expected: 403 Forbidden

GET {{apiUrl}}/evaluations/{{facultyEvaluationId}}
Authorization: Bearer {{otherFacultyLogin.response.body.$.data.accessToken}}


### 25. Unassigned Faculty Adviser Views Internship Evaluations
###
### Expected: 403 Forbidden

GET {{apiUrl}}/evaluations/internship/{{internshipId}}
Authorization: Bearer {{otherFacultyLogin.response.body.$.data.accessToken}}


### 26. Unassigned Faculty Adviser Creates Evaluation
###
### Expected: 403 Forbidden

POST {{apiUrl}}/evaluations
Authorization: Bearer {{otherFacultyLogin.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "internship_id": "{{internshipId}}",
  "evaluation_type": "faculty_adviser",
  "responses": {
    "criterion_1": 5,
    "criterion_2": 4
  }
}


###############################################################
# EVALUATION TYPE AUTHORIZATION
###############################################################


### 27. HTE Supervisor Attempts Faculty Adviser Evaluation
###
### Expected: 403 Forbidden
###
### HTE Supervisor may only create hte_supervisor evaluations.

POST {{apiUrl}}/evaluations
Authorization: Bearer {{hteSupervisorLogin.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "internship_id": "{{internshipId}}",
  "evaluation_type": "faculty_adviser",
  "responses": {
    "criterion_1": 5,
    "criterion_2": 4,
    "criterion_3": 5
  }
}


### 28. Faculty Adviser Attempts HTE Supervisor Evaluation
###
### Expected: 403 Forbidden
###
### Faculty Adviser may only create faculty_adviser evaluations.

POST {{apiUrl}}/evaluations
Authorization: Bearer {{facultyLogin.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "internship_id": "{{internshipId}}",
  "evaluation_type": "hte_supervisor",
  "responses": {
    "criterion_1": 5,
    "criterion_2": 4,
    "criterion_3": 5
  }
}


###############################################################
# DUPLICATE EVALUATION
###############################################################


### 29. Duplicate HTE Evaluation
###
### Expected: 400 Bad Request
###
### Student 1 already has an HTE Supervisor evaluation.
###
### The system must prevent another HTE evaluation
### for the same internship.

POST {{apiUrl}}/evaluations
Authorization: Bearer {{hteSupervisorLogin.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "internship_id": "{{internshipId}}",
  "evaluation_type": "hte_supervisor",
  "responses": {
    "criterion_1": 5,
    "criterion_2": 5,
    "criterion_3": 5
  }
}


### 30. Duplicate Faculty Adviser Evaluation
###
### Expected: 400 Bad Request
###
### Student 1 already has a Faculty Adviser evaluation.

POST {{apiUrl}}/evaluations
Authorization: Bearer {{facultyLogin.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "internship_id": "{{internshipId}}",
  "evaluation_type": "faculty_adviser",
  "responses": {
    "criterion_1": 5,
    "criterion_2": 5,
    "criterion_3": 5
  }
}


###############################################################
# VALIDATION TESTS
###############################################################


### 31. Invalid Rating - Too High
###
### Expected: 400 Bad Request

POST {{apiUrl}}/evaluations
Authorization: Bearer {{hteSupervisorLogin.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "internship_id": "{{internshipId}}",
  "evaluation_type": "hte_supervisor",
  "responses": {
    "criterion_1": 6
  }
}


### 32. Invalid Rating - Too Low
###
### Expected: 400 Bad Request

POST {{apiUrl}}/evaluations
Authorization: Bearer {{hteSupervisorLogin.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "internship_id": "{{internshipId}}",
  "evaluation_type": "hte_supervisor",
  "responses": {
    "criterion_1": 0
  }
}


### 33. Invalid Rating - Decimal
###
### Expected: 400 Bad Request

POST {{apiUrl}}/evaluations
Authorization: Bearer {{hteSupervisorLogin.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "internship_id": "{{internshipId}}",
  "evaluation_type": "hte_supervisor",
  "responses": {
    "criterion_1": 4.5
  }
}


### 34. Empty Responses
###
### Expected: 400 Bad Request

POST {{apiUrl}}/evaluations
Authorization: Bearer {{hteSupervisorLogin.response.body.$.data.accessToken}}
Content-Type: application/json

