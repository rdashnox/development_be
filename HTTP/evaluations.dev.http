  "evaluation_type": "hte_supervisor",
  "responses": {}
}


### 35. Invalid Internship ID
###
### Expected: 400 Bad Request

POST {{apiUrl}}/evaluations
Authorization: Bearer {{hteSupervisorLogin.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "internship_id": "not-a-uuid",
  "evaluation_type": "hte_supervisor",
  "responses": {
    "criterion_1": 5
  }
}


###############################################################
# FINAL ELIGIBILITY TESTS
###############################################################

### IMPORTANT:
### These tests require a NON-ELIGIBLE internship.
###
### Use an internship where:
### - end_date has not passed, OR
### - required_hours has not been met.
###
### Do NOT use the seeded Student 1/3/4 completed internships
### for these tests because they are intentionally eligible.


### 36. Create Evaluation Before Internship Period Ends
###
### Expected: 400 Bad Request
###
### Expected business error:
### "The internship period has not ended yet."

# Replace with an active/non-ended internship UUID.
@ineligibleInternshipId=REPLACE_WITH_INELIGIBLE_INTERNSHIP_UUID


POST {{apiUrl}}/evaluations
Authorization: Bearer {{hteSupervisorLogin.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "internship_id": "{{ineligibleInternshipId}}",
  "evaluation_type": "hte_supervisor",
  "responses": {
    "criterion_1": 5,
    "criterion_2": 4,
    "criterion_3": 5
  }
}


### 37. Create Evaluation With Insufficient Validated Hours
###
### Expected: 400 Bad Request
###
### Expected business error:
### "The required validated rendered hours have not been met."
###
### Use an internship whose end date has passed but whose
### validated rendered hours are below required_hours.

# Replace with an internship that has insufficient hours.
@insufficientHoursInternshipId=REPLACE_WITH_INSUFFICIENT_HOURS_INTERNSHIP_UUID


POST {{apiUrl}}/evaluations
Authorization: Bearer {{hteSupervisorLogin.response.body.$.data.accessToken}}
Content-Type: application/json

{
  "internship_id": "{{insufficientHoursInternshipId}}",
  "evaluation_type": "hte_supervisor",
  "responses": {
    "criterion_1": 5,
    "criterion_2": 4,
    "criterion_3": 5
  }
}


