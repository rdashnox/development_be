###############################################################
# HTE Management Module
#
# Manual API Test Suite
# VS Code REST Client
#
# Includes:
# - HTE CRUD
# - HTE activation/deactivation
# - HTE supervisor assignment
# - Students assigned to a specific HTE
# - Students assigned to authenticated HTE supervisor
# - Validation
# - Authentication
# - Authorization
#
# Test order:
# 1. Variables
# 2. Health Check
# 3. Administrator Login
# 4. Coordinator Login
# 5. HTE Supervisor Login
# 6. HTE List
# 7. HTE Create
# 8. HTE Retrieve
# 9. HTE Update
# 10. HTE Assign Supervisor
# 11. HTE Students
# 12. HTE Supervisor Students
# 13. HTE Deactivate
# 14. HTE Reactivate
# 15. Validation Tests
# 16. Non-existent HTE
# 17. Authentication Tests
# 18. Authorization Tests
#
###############################################################


###############################################################
# VARIABLES
###############################################################

@apiUrl=http://localhost:8000/api/v1

### HTE ID
### Replace after creating an HTE.
@hteId=ead13b5c-4d43-44b8-953f-227ff180ba64
### HTE Supervisor User ID
### Replace with the ID of a profile whose role is hte_supervisor.
@hteSupervisorUserId=2300ead7-6b42-4d29-a07d-cd91c4b4b4e8

### Student User ID
### Replace with a student assigned to the HTE for testing.
@studentUserId=bcfb4652-2a62-4383-a986-33e838ed3631


###############################################################
# SEED USERS
###############################################################

@admin=adminsbims1@grr.la
@coordinator=coordinatorsbims1@grr.la
@faculty=facultysbims1@grr.la
@student=studentsbims1@grr.la
@hte=htesbims3@grr.la


###############################################################
# PASSWORDS
###############################################################
@defaultPassword=Dev2026!
@newPassword=deV2026!
@renewPassword=deV2026#


###############################################################
# ACCESS TOKENS
###############################################################
@adminToken=PASTE_ADMIN_ACCESS_TOKEN_HERE
@coordinatorToken=eyJhbGciOiJFUzI1NiIsImtpZCI6IjI4OGQ4NzFhLWEzZDItNDA0Ni04Y2QwLTJlZTJhZmM1NmY4ZiIsInR5cCI6IkpXVCJ9..2_ToRJ-65CB-FEXx4DRaau5KaLgJYC6QT-kENQRt1dwH_TRtxP0tz2SjSnMfy4gnlvkXTyzX9Hx7mr4g7__ivg
@hteSupervisorToken=eyJhbGciOiJFUzI1NiIsImtpZCI6IjI4OGQ4NzFhLWEzZDItNDA0Ni04Y2QwLTJlZTJhZmM1NmY4ZiIsInR5cCI6IkpXVCJ9..dstznJN0q-ieaz8Ns9yWbEB1J3IJbJnAq6w8AmsC-CRXxR7N0b42LE-PheBXhmELpfvLH1b2_E3NMlh5WiIh-g
@facultyToken=eyJhbGciOiJFUzI1NiIsImtpZCI6IjI4OGQ4NzFhLWEzZDItNDA0Ni04Y2QwLTJlZTJhZmM1NmY4ZiIsInR5cCI6IkpXVCJ9..wCPxeSZ2-G9gfajmMqj1tuZNOBcOFJX2XbYb_dWmqTmmGBgFx-Muyb2Vc1EBDoRu4qg2GMbqpQuhDsGYa6HCJQ
@studentToken=PASTE_STUDENT_ACCESS_TOKEN_HERE

###############################################################
# HEALTH
###############################################################

### Health Check
GET {{apiUrl}}/health

### Expected:
### HTTP 200
### success = true


###############################################################
# ADMINISTRATOR LOGIN
###############################################################

### Administrator Login
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{admin}}",
  "password": "{{newPassword}}"
}

### Expected:
### HTTP 200
### success = true
### data.accessToken is returned
### Copy accessToken to @adminAccessToken


###############################################################
# INTERNSHIP COORDINATOR LOGIN
###############################################################

### Internship Coordinator Login
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{coordinator}}",
  "password": "{{defaultPassword}}"
}

### Expected:
### HTTP 200
### success = true
### data.accessToken is returned
### Copy accessToken to @coordinatorAccessToken


###############################################################
# HTE SUPERVISOR LOGIN
###############################################################

### HTE Supervisor Login
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{hte}}",
  "password": "{{defaultPassword}}"
}

### Expected:
### HTTP 200
### success = true
### data.accessToken is returned
### Copy accessToken to @hteSupervisorAccessToken
### Verify returned user.role = "hte_supervisor"


###############################################################
# HTE LIST
###############################################################

### FR-04 - Administrator List HTE Profiles
GET {{apiUrl}}/htes
Authorization: Bearer {{adminToken}}

### Expected:
### HTTP 200
### success = true
### data = array


### FR-04 - Internship Coordinator List HTE Profiles
GET {{apiUrl}}/htes
Authorization: Bearer {{coordinatorToken}}

### Expected:
### HTTP 200
### success = true
### data = array


###############################################################
# HTE CREATE
###############################################################

### FR-04 - Administrator Create HTE
POST {{apiUrl}}/htes
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "companyName": "REST Client Test HTE",
  "address": "Test Address, Bulacan",
  "contactPerson": "Test Contact Person",
  "contactEmail": "contact@example.com",
  "contactNumber": "09171234567"
}

### Expected:
### HTTP 201
### success = true
### data.id exists
### data.company_name = "REST Client Test HTE"
### data.address = "Test Address, Bulacan"
### data.contact_person = "Test Contact Person"
### data.contact_email = "contact@example.com"
### data.contact_number = "09171234567"
### data.supervisor_id = null
### data.is_active = true
### data.created_at exists
### data.updated_at exists
###
### Copy data.id to @hteId


### FR-04 - Internship Coordinator Create HTE
POST {{apiUrl}}/htes
Authorization: Bearer {{coordinatorToken}}
Content-Type: application/json

{
  "companyName": "ABC Industries",
  "address": "Technology Hub Avenue, Taguig City",
  "contactPerson": "Roberto Luis F. Valderama",
  "contactEmail": "htesbims1@grr.la",
  "contactNumber": "09171234567"
}

### Expected:
### HTTP 201
### success = true
### HTE profile is created
### data.supervisor_id = null


###############################################################
# HTE RETRIEVE
###############################################################

### FR-04 - Retrieve HTE Profile
GET {{apiUrl}}/htes/{{hteId}}
Authorization: Bearer {{coordinatorToken}}

### Expected:
### HTTP 200
### success = true
### data.id = {{hteId}}
### data.supervisor_id is present
### data.is_active is present


###############################################################
# HTE UPDATE
###############################################################

### FR-04 - Update HTE Profile
PATCH {{apiUrl}}/htes/{{hteId}}
Authorization: Bearer {{coordinatorToken}}
Content-Type: application/json

{
  "companyName": "ABC Industries Inc.",
  "contactPerson": "Roberto Luis F. Valderama"
}

### Expected:
### HTTP 200
### success = true
### data.id = {{hteId}}
### data.company_name = "ABC Industries Inc."
### data.contact_person = "Roberto Luis F. Valderama"
### Existing address remains unchanged


### FR-04 - Partial HTE Update
PATCH {{apiUrl}}/htes/{{hteId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "address": "Updated HTE Address, Bulacan"
}

### Expected:
### HTTP 200
### success = true
### data.address = "Updated HTE Address, Bulacan"


###############################################################
# HTE SUPERVISOR ASSIGNMENT
###############################################################

### Assign HTE Supervisor
### The selected profile must have role = "hte_supervisor".
### The selected account must be active.

PATCH {{apiUrl}}/htes/{{hteId}}/supervisor
Authorization: Bearer {{coordinatorToken}}
Content-Type: application/json

{
  "supervisorId": "{{hteSupervisorUserId}}"
}

### Expected:
### HTTP 200
### success = true
### data.id = {{hteId}}
### data.supervisor_id = {{hteSupervisorUserId}}


### Verify Assigned Supervisor
GET {{apiUrl}}/htes/{{hteId}}
Authorization: Bearer {{coordinatorToken}}

### Expected:
### HTTP 200
### data.supervisor_id = {{hteSupervisorUserId}}


###############################################################
# HTE STUDENTS
###############################################################

### GET STUDENTS ASSIGNED TO SPECIFIC HTE
###
### Returns student interns associated with this HTE.
### The HTE is identified by {{hteId}}.
###
### Accessible by:
### - administrator
### - internship_coordinator
###
### Expected:
### HTTP 200
### success = true
### data = array
### Each student belongs to this HTE.

GET {{apiUrl}}/htes/{{hteId}}/students
Authorization: Bearer {{coordinatorToken}}


### Administrator Gets Students Assigned To HTE
GET {{apiUrl}}/htes/{{hteId}}/students
Authorization: Bearer {{coordinatorToken}}

### Expected:
### HTTP 200
### success = true
### data = array


###############################################################
# HTE SUPERVISOR - MY STUDENTS
###############################################################

### GET STUDENTS ASSIGNED TO AUTHENTICATED HTE SUPERVISOR
###
### IMPORTANT:
### This endpoint does not accept an HTE ID.
###
### The backend determines the authenticated HTE supervisor
### from the access token and returns students associated
### with the HTE assigned to that supervisor.
###
### Endpoint:
### GET /htes/my/students
###
### Accessible by:
### - hte_supervisor
###
### Expected:
### HTTP 200
### success = true
### data = array

GET {{apiUrl}}/htes/my/students
Authorization: Bearer {{hteSupervisorToken}}


###############################################################
# HTE SUPERVISOR - VERIFY ONLY OWN ASSIGNED STUDENTS
###############################################################

### This test verifies that an HTE supervisor does not receive
### students belonging to another HTE.
###
### Expected:
### - HTTP 200
### - Only students associated with the supervisor's HTE
### - No students from unrelated HTEs


GET {{apiUrl}}/htes/my/students
Authorization: Bearer {{hteSupervisorToken}}


###############################################################
# HTE DEACTIVATE
###############################################################

### FR-04 - Deactivate HTE
PATCH {{apiUrl}}/htes/{{hteId}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "isActive": false
}

### Expected:
### HTTP 200
### success = true
### data.is_active = false


###############################################################
# HTE REACTIVATE
###############################################################

### FR-04 - Reactivate HTE
PATCH {{apiUrl}}/htes/{{hteId}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "isActive": true
}

### Expected:
### HTTP 200
### success = true
### data.is_active = true


###############################################################
# VALIDATION - CREATE
###############################################################

### Invalid HTE Data
POST {{apiUrl}}/htes
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "companyName": "",
  "address": "",
  "contactPerson": "",
  "contactEmail": "not-an-email",
  "contactNumber": ""
}

### Expected:
### HTTP 400
### Validation error


### Missing Required HTE Fields
POST {{apiUrl}}/htes
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "companyName": "Incomplete HTE"
}

### Expected:
### HTTP 400
### Validation error


### Invalid Contact Email
POST {{apiUrl}}/htes
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "companyName": "Invalid Email HTE",
  "address": "Test Address",
  "contactPerson": "Test Person",
  "contactEmail": "invalid-email",
  "contactNumber": "09171234567"
}

### Expected:
### HTTP 400


### Empty Contact Number
POST {{apiUrl}}/htes
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "companyName": "Empty Number HTE",
  "address": "Test Address",
  "contactPerson": "Test Person",
  "contactEmail": "test@example.com",
  "contactNumber": ""
}

### Expected:
### HTTP 400


###############################################################
# VALIDATION - UPDATE
###############################################################

### Empty HTE Update
PATCH {{apiUrl}}/htes/{{hteId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{}

### Expected:
### HTTP 400
### At least one HTE profile field is required.


### Empty Company Name
PATCH {{apiUrl}}/htes/{{hteId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "companyName": ""
}

### Expected:
### HTTP 400


### Empty Address
PATCH {{apiUrl}}/htes/{{hteId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "address": ""
}

### Expected:
### HTTP 400


### Invalid Update Email
PATCH {{apiUrl}}/htes/{{hteId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "contactEmail": "invalid-email"
}

### Expected:
### HTTP 400


###############################################################
# VALIDATION - SUPERVISOR
###############################################################

### Invalid Supervisor UUID
PATCH {{apiUrl}}/htes/{{hteId}}/supervisor
Authorization: Bearer {{coordinatorToken}}
Content-Type: application/json

{
  "supervisorId": "not-a-uuid"
}

### Expected:
### HTTP 400


### Non-existent Supervisor
PATCH {{apiUrl}}/htes/{{hteId}}/supervisor
Authorization: Bearer {{coordinatorToken}}
Content-Type: application/json

{
  "supervisorId": "00000000-0000-0000-0000-000000000000"
}

### Expected:
### HTTP 404
### HTE supervisor profile not found.


### User With Wrong Role As Supervisor
###
### Use a real active user who is NOT an hte_supervisor.
###
PATCH {{apiUrl}}/htes/{{hteId}}/supervisor
Authorization: Bearer {{coordinatorToken}}
Content-Type: application/json

{
  "supervisorId": "{{studentUserId}}"
}

### Expected:
### HTTP 400
### The selected user is not an HTE supervisor.


### Remove HTE Supervisor
PATCH {{apiUrl}}/htes/{{hteId}}/supervisor
Authorization: Bearer {{coordinatorToken}}
Content-Type: application/json

{
  "supervisorId": null
}

### Expected:
### HTTP 200
### data.supervisor_id = null


###############################################################
# VALIDATION - STATUS
###############################################################

### Invalid HTE Status
PATCH {{apiUrl}}/htes/{{hteId}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "isActive": "false"
}

### Expected:
### HTTP 400
### isActive must be a boolean


### Missing HTE Status
PATCH {{apiUrl}}/htes/{{hteId}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{}

### Expected:
### HTTP 400


###############################################################
# NOT FOUND
###############################################################

### Non-existent HTE
GET {{apiUrl}}/htes/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{adminToken}}

### Expected:
### HTTP 404
### HTE profile not found.


### Get Students For Non-existent HTE
GET {{apiUrl}}/htes/00000000-0000-0000-0000-000000000000/students
Authorization: Bearer {{adminToken}}

### Expected:
### HTTP 404
### HTE profile not found.


### Update Non-existent HTE
PATCH {{apiUrl}}/htes/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "companyName": "Should Not Exist"
}

### Expected:
### HTTP 404


### Change Status of Non-existent HTE
PATCH {{apiUrl}}/htes/00000000-0000-0000-0000-000000000000/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "isActive": false
}

### Expected:
### HTTP 404


