###############################################################

# Student Internship Profile Module (FR-03)

#

# Order of execution:

#

# 1. Login Coordinator

# 2. Login Student

# 3. Login Faculty Adviser

# 4. Login Administrator

# 5. Create Student Profile

# 6. Duplicate Student Profile

# 7. Retrieve Student Profile + User Profile

# 8. Student Retrieve Own Profile + User Profile

# 9. Student Update Own Information

# 10. Verify Protected Fields

# 11. Coordinator Retrieves All Students

# 12. Faculty Adviser Retrieves Assigned Students

# 13. Faculty Adviser Retrieves Assigned Student By ID

# 14. Faculty Adviser Cannot Retrieve Unassigned Student

# 15. Authorization Tests

# 16. Unauthenticated Access

# 17. Final Student Profile Verification

#

###############################################################

###############################################################

# Variables

###############################################################

@apiUrl=http://localhost:8000/api/v1

###############################################################

# Seed Users

###############################################################

@admin=adminsbims1@grr.la
@student=studentsbims1@grr.la
@faculty=facultysbims1@grr.la
@coordinator=coordinatorsbims1@grr.la
###
@defaultPassword=Dev2026!
@newPassword=deV2026!

###############################################################

# User IDs

#

# Replace adminUserId with the ID returned by administrator login.

###############################################################

@adminUserId=ADD_HERE
@studentUserId=0afd9f69-0991-4d14-a0e9-6446b0109e83
@facultyUserId=cd315baa-c628-4ff9-9f71-9caae86ed096
@coordinatorUserId=01501d31-a58b-4034-8b5c-b0b6f9ece378

###############################################################

# Tokens

#

# Replace these after performing the corresponding login.

###############################################################

@adminToken=PASTE_ADMIN_ACCESS_TOKEN
@studentToken=PASTE_STUDENT_ACCESS_TOKEN
@facultyToken=PASTE_FACULTY_ACCESS_TOKEN
@coordinatorToken=PASTE_COORDINATOR_ACCESS_TOKEN
@hteToken=PASTE_HTE_ACCESS_TOKEN

###############################################################

# Known Internship

#

# This student is expected to have an operational internship

# assigned to the faculty adviser above.

#

# Use this student for faculty "assigned" tests.

###############################################################

@assignedStudentId={{studentUserId}}

###############################################################

# Optional Unassigned Student

#

# Replace this with another student profile ID that is NOT

# assigned to @facultyUserId.

#

# This is required for the faculty 403 test.

###############################################################

@unassignedStudentId=ADD_UNASSIGNED_STUDENT_ID

###############################################################

# LOGIN INTERNSHIP COORDINATOR

###############################################################

POST {{apiUrl}}/auth/login
Content-Type: application/json

{
"email": "{{coordinator}}",
"password": "{{defaultPassword}}"
}

###############################################################

# LOGIN STUDENT

###############################################################

POST {{apiUrl}}/auth/login
Content-Type: application/json

{
"email": "{{student}}",
"password": "{{defaultPassword}}"
}

###############################################################

# LOGIN FACULTY ADVISER

###############################################################

POST {{apiUrl}}/auth/login
Content-Type: application/json

{
"email": "{{faculty}}",
"password": "{{defaultPassword}}"
}

###############################################################

# LOGIN ADMINISTRATOR

###############################################################

POST {{apiUrl}}/auth/login
Content-Type: application/json

{
"email": "{{admin}}",
"password": "{{newPassword}}"
}

###############################################################

# FR-03 CREATE STUDENT PROFILE

###############################################################

### Coordinator Creates Student Profile

###

### Permission:

### - administrator

### - internship_coordinator

###

### Expected:

### - HTTP 201

### - success = true

### - Student profile created

### - id matches student user ID

### - profiles relationship is returned

### - profiles.id matches student user ID

### - profiles.role = student

POST {{apiUrl}}/students
Authorization: Bearer {{coordinatorToken}}
Content-Type: application/json

{
"userId": "{{studentUserId}}",
"studentNumber": "2023001",
"program": "BS Computer Science",
"yearLevel": 3,
"section": "A1",
"contactNumber": "09123456789",
"address": "3494 Lucban Avenue, Makati City, Metro Manila",
"emergencyContactName": "Juan Cruz",
"emergencyContactNumber": "09987654321"
}

###############################################################

# FR-03 RETRIEVE STUDENT PROFILE BY ID

###############################################################

### Internship Coordinator Retrieves Student Profile

###

### Expected:

### - HTTP 200

### - success = true

### - Profile returned

### - id = student user ID

### - profiles object exists

### - profiles.id = student user ID

### - profiles.email is returned

### - profiles.first_name is returned

### - profiles.last_name is returned

### - profiles.role = student

### - profiles.is_active = true

GET {{apiUrl}}/students/{{studentUserId}}
Authorization: Bearer {{coordinatorToken}}

###############################################################

# FR-03 STUDENT RETRIEVES OWN PROFILE

###############################################################

### Student Self-Service

###

### Expected:

### - HTTP 200

### - success = true

### - Student's own profile returned

### - profiles object exists

### - profiles.id = authenticated student ID

### - profiles.role = student

GET {{apiUrl}}/students/me
Authorization: Bearer {{studentToken}}

###############################################################

# FR-03 STUDENT UPDATE OWN INFORMATION

###############################################################

### Student Updates Editable Information

###

### Expected:

### - HTTP 200

### - contact_number updated

### - address updated

### - profiles relationship remains present

PATCH {{apiUrl}}/students/me
Authorization: Bearer {{studentToken}}
Content-Type: application/json

{
"emergencyContactName": "Juan Dimalanta",
"emergencyContactNumber": "09987654000"
}

###############################################################

# FR-03 VERIFY STUDENT UPDATE

###############################################################

### Verify Editable Information

###

### Expected:

### - HTTP 200

### - Updated contact number returned

### - Updated address returned

### - profiles object still returned

GET {{apiUrl}}/students/me
Authorization: Bearer {{studentToken}}

###############################################################

# FR-03 VERIFY PROTECTED FIELDS

###############################################################

### Student Attempts To Modify Protected Fields

###

### Protected fields:

### - studentNumber

### - program

### - yearLevel

###

### internshipStatus is intentionally NOT included because

### it was removed from student_profiles.

###

### Expected:

### - HTTP 200 because unknown/protected fields are not part

### of updateMyStudentSchema

### - Only allowed fields are processed

### - studentNumber remains unchanged

### - program remains unchanged

### - yearLevel remains unchanged

PATCH {{apiUrl}}/students/me
Authorization: Bearer {{studentToken}}
Content-Type: application/json

{
"studentNumber": "HACKED-STUDENT-NUMBER",
"program": "Hacked Program",
"yearLevel": 1
}

###############################################################

# FR-03 VERIFY PROTECTED FIELDS WERE NOT MODIFIED

###############################################################

### Expected:

### - HTTP 200

### - Original studentNumber remains unchanged

### - Original program remains unchanged

### - Original yearLevel remains unchanged

GET {{apiUrl}}/students/me
Authorization: Bearer {{studentToken}}

###############################################################

# FR-03 STUDENT CANNOT RETRIEVE PROFILE THROUGH /:id

###############################################################

### Student Attempts Staff Profile Endpoint

###

### Expected:

### - HTTP 403 Forbidden

GET {{apiUrl}}/students/{{studentUserId}}
Authorization: Bearer {{studentToken}}

###############################################################

# FR-03 COORDINATOR GETS ALL STUDENTS

###############################################################

### Internship Coordinator Retrieves All Students

###

### Expected:

### - HTTP 200

### - success = true

### - data is an array

### - Each student contains profiles

### - profiles.id corresponds to student id

### - profiles.role = student

### - currentInternship is present when applicable

GET {{apiUrl}}/students
Authorization: Bearer {{coordinatorToken}}

###############################################################

# FR-03 ADMINISTRATOR GETS ALL STUDENTS

###############################################################

### Administrator Retrieves All Students

###

### Expected:

### - HTTP 200

### - success = true

### - data is an array

### - Each student contains profiles

GET {{apiUrl}}/students
Authorization: Bearer {{adminToken}}

###############################################################

# FR-03 FACULTY GETS ASSIGNED STUDENTS

###############################################################

### Faculty Adviser Retrieves Assigned Students

###

### Endpoint:

### GET /students/assigned

###

### Expected:

### - HTTP 200

### - success = true

### - data is an array

### - Only students assigned to the authenticated faculty adviser

### are returned

### - Assignment must be through a pending or active internship

### - Each student contains profiles

### - Each student contains currentInternship

### - currentInternship.faculty_adviser_id matches faculty user ID

GET {{apiUrl}}/students/assigned
Authorization: Bearer {{facultyToken}}

###############################################################

# FR-03 FACULTY RETRIEVES ASSIGNED STUDENT BY ID

###############################################################

### Faculty Adviser Retrieves Assigned Student

###

### Expected:

### - HTTP 200

### - success = true

### - Student is returned

### - profiles object is returned

### - currentInternship is returned

### - currentInternship.faculty_adviser_id matches faculty user ID

GET {{apiUrl}}/students/{{assignedStudentId}}
Authorization: Bearer {{facultyToken}}

###############################################################

# FR-03 FACULTY CANNOT RETRIEVE UNASSIGNED STUDENT

###############################################################

### Faculty Adviser Attempts To Retrieve Unassigned Student

###

### Replace @unassignedStudentId with a student that is NOT

### assigned to @facultyUserId.

###

### Expected:

### - HTTP 403 Forbidden

### - Student profile is not exposed

GET {{apiUrl}}/students/{{unassignedStudentId}}
Authorization: Bearer {{facultyToken}}

###############################################################

# FR-03 FACULTY CANNOT CREATE STUDENT PROFILE

###############################################################

### Faculty Adviser Attempts To Create Student Profile

###

### Expected:

### - HTTP 403 Forbidden

### - Authorization is checked before service logic

POST {{apiUrl}}/students
Authorization: Bearer {{facultyToken}}
Content-Type: application/json

{
"userId": "{{adminUserId}}",
"studentNumber": "FR03-FACULTY-001",
"program": "BS Information Technology",
"yearLevel": 4,
"section": "A",
"contactNumber": "09123456789",
"address": "Bulacan, Philippines",
"emergencyContactName": "Juan Cruz",
"emergencyContactNumber": "09987654321"
}

###############################################################

# FR-03 STUDENT CANNOT CREATE PROFILE

###############################################################

### Student Attempts To Create Own Profile

###

### Expected:

### - HTTP 403 Forbidden

### - Authorization checked before duplicate handling

POST {{apiUrl}}/students
Authorization: Bearer {{studentToken}}
Content-Type: application/json

{
"userId": "{{studentUserId}}",
"studentNumber": "FR03-STUDENT-001",
"program": "BS Information Technology",
"yearLevel": 4,
"section": "A",
"contactNumber": "09123456789",
"address": "Bulacan, Philippines",
"emergencyContactName": "Juan Cruz",
"emergencyContactNumber": "09987654321"
}

###############################################################

# FR-03 STUDENT CANNOT VIEW ALL STUDENTS

###############################################################

### Student Attempts To Retrieve All Students

###

### Expected:

### - HTTP 403 Forbidden

GET {{apiUrl}}/students
Authorization: Bearer {{studentToken}}

###############################################################

# FR-03 STUDENT CANNOT VIEW ASSIGNED STUDENTS

###############################################################

### Student Attempts Faculty Adviser Endpoint

###

### Expected:

### - HTTP 403 Forbidden

GET {{apiUrl}}/students/assigned
Authorization: Bearer {{studentToken}}

###############################################################

# FR-03 UNAUTHENTICATED ACCESS - /students/me

###############################################################

### Missing Token - Student Profile

###

### Expected:

### - HTTP 401 Unauthorized

GET {{apiUrl}}/students/me

###############################################################

# FR-03 UNAUTHENTICATED ACCESS - /students/:id

###############################################################

### Missing Token - Student Profile By ID

###

### Expected:

### - HTTP 401 Unauthorized

GET {{apiUrl}}/students/{{studentUserId}}

###############################################################

# FR-03 UNAUTHENTICATED ACCESS - /students

###############################################################

### Missing Token - All Students

###

### Expected:

### - HTTP 401 Unauthorized

GET {{apiUrl}}/students

###############################################################

# FR-03 UNAUTHENTICATED ACCESS - /students/assigned

###############################################################

### Missing Token - Assigned Students

###

### Expected:

### - HTTP 401 Unauthorized

GET {{apiUrl}}/students/assigned

###############################################################

# FR-03 FINAL STUDENT PROFILE VERIFICATION

###############################################################

### Final Student Self-Service Verification

###

### Expected:

### - HTTP 200

### - Profile exists

### - id matches authenticated student

### - profiles exists

### - profiles.id matches authenticated student

### - profiles.role = student

### - Editable information is preserved

GET {{apiUrl}}/students/me
Authorization: Bearer {{studentToken}}
